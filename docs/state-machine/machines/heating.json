{
  "glassbox": 1,
  "id": "heating",
  "title": "Heating controller",

  "notes": [
    "This is the CENTRAL HEATING circuit only, and that restriction is the",
    "finding. A real boiler serves two circuits — heating and hot water — which",
    "run independently: the water can be reheating while the radiators are",
    "satisfied, and either can be boosted without the other. They are not two",
    "modes of one machine, they are two machines sharing a boiler.",
    "",
    "The format cannot say that. Its options are both bad. Model the product —",
    "off, ch-only, hw-only, both — and six honest states become twenty-four,",
    "then multiply again if a third zone is ever added. Or write two artifacts,",
    "which is correct, and then discover the format has no way to state that two",
    "machines run together, share facts, and contend for one boiler.",
    "",
    "This is the AND-state, and it was predicted: the earlier design notes call",
    "concurrent machines alongside a mode machine exactly that, and answer it",
    "with 'one machine, several instances sharing an environment'. That answer",
    "is still right and is still not implemented — `worldFrom` makes one world",
    "for one machine, and nothing composes two.",
    "",
    "So the honest artifact is one circuit, and the missing feature has a name."
  ],

  "initial": "off",

  "states": [
    { "id": "off",       "label": "Off" },
    { "id": "frost",     "label": "Frost watch" },
    { "id": "satisfied", "label": "Up to temperature" },
    { "id": "heating",   "label": "Heating" },
    { "id": "boosting",  "label": "Boost" },
    { "id": "fault",     "label": "Fault" }
  ],

  "events": [
    { "id": "mode",       "label": "mode",           "source": "user" },
    { "id": "boost",      "label": "boost",          "source": "user" },
    { "id": "cancel",     "label": "cancel boost",   "source": "user" },
    { "id": "reset",      "label": "reset",          "source": "user" },
    { "id": "calls",      "label": "thermostat calls",     "source": "runtime" },
    { "id": "satisfies",  "label": "thermostat satisfied", "source": "runtime" },
    { "id": "boost-over", "label": "boost elapsed",  "source": "runtime" },
    { "id": "faults",     "label": "boiler fault",   "source": "runtime" }
  ],

  "config": [
    { "id": "has-frost-watch", "label": "Frost protection fitted", "default": true },
    { "id": "boost-minutes",   "label": "Boost lasts (minutes)",   "default": 60 }
  ],

  "facts": [
    { "id": "scheduled-on", "label": "The timer says it should be on" },
    { "id": "below-frost",  "label": "It is cold enough to worry about pipes" }
  ],

  "refusals": [
    { "id": "in-fault",   "text": "the boiler has locked out; reset it first" },
    { "id": "no-frost",   "text": "this controller has no frost protection" },
    { "id": "not-boosting", "text": "no boost is running" }
  ],

  "rules": [
    { "from": "off", "on": "mode", "cases": [
      { "when": { "fact": "scheduled-on" }, "to": "heating" },
      { "to": "satisfied" }
    ]},
    { "from": "off", "on": "calls", "cases": [
      { "when": { "all": [ { "config": "has-frost-watch" }, { "fact": "below-frost" } ] }, "to": "frost" },
      { "stay": true }
    ]},
    { "from": "off", "on": "boost", "cases": [
      { "when": { "not": { "config": "has-frost-watch" } }, "refuse": "no-frost" },
      { "to": "boosting" }
    ]},
    { "from": "off", "on": "cancel",     "cases": [ { "refuse": "not-boosting" } ] },
    { "from": "off", "on": "reset",      "cases": [ { "stay": true } ] },
    { "from": "off", "on": "satisfies",  "cases": [ { "stay": true } ] },
    { "from": "off", "on": "boost-over", "cases": [ { "stay": true } ] },
    { "from": "off", "on": "faults",     "cases": [ { "to": "fault" } ] },

    { "from": "frost", "on": "satisfies",  "cases": [ { "to": "off" } ] },
    { "from": "frost", "on": "mode",       "cases": [ { "to": "satisfied" } ] },
    { "from": "frost", "on": "boost",      "cases": [ { "to": "boosting" } ] },
    { "from": "frost", "on": "faults",     "cases": [ { "to": "fault" } ] },
    { "from": "frost", "on": "calls",      "cases": [ { "stay": true } ] },
    { "from": "frost", "on": "cancel",     "cases": [ { "refuse": "not-boosting" } ] },
    { "from": "frost", "on": "reset",      "cases": [ { "stay": true } ] },
    { "from": "frost", "on": "boost-over", "cases": [ { "stay": true } ] },

    { "from": "satisfied", "on": "calls", "cases": [
      { "when": { "fact": "scheduled-on" }, "to": "heating" },
      { "stay": true }
    ]},
    { "from": "satisfied", "on": "mode",       "cases": [ { "to": "off" } ] },
    { "from": "satisfied", "on": "boost",      "cases": [ { "to": "boosting" } ] },
    { "from": "satisfied", "on": "faults",     "cases": [ { "to": "fault" } ] },
    { "from": "satisfied", "on": "satisfies",  "cases": [ { "stay": true } ] },
    { "from": "satisfied", "on": "cancel",     "cases": [ { "refuse": "not-boosting" } ] },
    { "from": "satisfied", "on": "reset",      "cases": [ { "stay": true } ] },
    { "from": "satisfied", "on": "boost-over", "cases": [ { "stay": true } ] },

    { "from": "heating", "on": "satisfies",  "cases": [ { "to": "satisfied" } ] },
    { "from": "heating", "on": "mode",       "cases": [ { "to": "off" } ] },
    { "from": "heating", "on": "boost",      "cases": [ { "to": "boosting" } ] },
    { "from": "heating", "on": "faults",     "cases": [ { "to": "fault" } ] },
    { "from": "heating", "on": "calls",      "cases": [ { "stay": true } ] },
    { "from": "heating", "on": "cancel",     "cases": [ { "refuse": "not-boosting" } ] },
    { "from": "heating", "on": "reset",      "cases": [ { "stay": true } ] },
    { "from": "heating", "on": "boost-over", "cases": [ { "stay": true } ] },

    { "from": "boosting", "on": "boost-over", "cases": [
      { "when": { "fact": "scheduled-on" }, "to": "heating" },
      { "to": "satisfied" }
    ]},
    { "from": "boosting", "on": "cancel", "cases": [
      { "when": { "fact": "scheduled-on" }, "to": "heating" },
      { "to": "satisfied" }
    ]},
    { "from": "boosting", "on": "faults",    "cases": [ { "to": "fault" } ] },
    { "from": "boosting", "on": "mode",      "cases": [ { "to": "off" } ] },
    { "from": "boosting", "on": "boost",     "cases": [ { "stay": true } ] },
    { "from": "boosting", "on": "calls",     "cases": [ { "stay": true } ] },
    { "from": "boosting", "on": "satisfies", "cases": [ { "stay": true } ] },
    { "from": "boosting", "on": "reset",     "cases": [ { "stay": true } ] },

    { "from": "fault", "on": "reset",      "cases": [ { "to": "off" } ] },
    { "from": "fault", "on": "mode",       "cases": [ { "refuse": "in-fault" } ] },
    { "from": "fault", "on": "boost",      "cases": [ { "refuse": "in-fault" } ] },
    { "from": "fault", "on": "cancel",     "cases": [ { "refuse": "in-fault" } ] },
    { "from": "fault", "on": "calls",      "cases": [ { "stay": true } ] },
    { "from": "fault", "on": "satisfies",  "cases": [ { "stay": true } ] },
    { "from": "fault", "on": "boost-over", "cases": [ { "stay": true } ] },
    { "from": "fault", "on": "faults",     "cases": [ { "stay": true } ] }
  ],

  "deadlines": [
    { "in": "boosting", "fires": "boost-over", "after": { "config": "boost-minutes" } }
  ]
}
