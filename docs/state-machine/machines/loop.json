{
  "glassbox": 2,
  "id": "loop",
  "title": "One loop of a six-loop looper",

  "notes": [
    "Commands, added with the effects fork. Every one of them hangs off a",
    "STATE rather than an edge, so 'entering Recording starts the recorder' is",
    "said once and holds for all four ways in.",
    "",
    "This machine also found the one place the shape is awkward, and it is",
    "recorded here rather than papered over. Playing -> Overdub emits",
    "stop-playback then start-overdub, because leaving Playing exits it; a real",
    "looper wants a handover, not a stop followed by a start. Nothing in the",
    "format is wrong — the modelling is, and there are two honest fixes. Either",
    "the host reads the pair as a handover, or overdub stops being a state and",
    "becomes a fact about Playing. It is exactly the case edge-specific",
    "commands were held back to wait for, and it is not yet convincing enough",
    "to add them."
  ],

  "initial": "empty",

  "states": [
    { "id": "empty",       "label": "Empty",     "entry": ["discard-audio"] },
    { "id": "armed",       "label": "Armed",     "entry": ["start-count-in"], "exit": ["stop-count-in"] },
    { "id": "recording",   "label": "Recording", "entry": ["start-recorder"], "exit": ["stop-recorder"] },
    { "id": "playing",     "label": "Playing",   "entry": ["start-playback"], "exit": ["stop-playback"] },
    { "id": "overdubbing", "label": "Overdub",   "entry": ["start-overdub"],  "exit": ["stop-overdub"] },
    { "id": "stopped",     "label": "Stopped" }
  ],

  "events": [
    { "id": "record",  "label": "record",   "source": "user" },
    { "id": "play",    "label": "play",     "source": "user" },
    { "id": "stop",    "label": "stop",     "source": "user" },
    { "id": "clear",   "label": "clear",    "source": "user" },
    { "id": "elapsed", "label": "count-in", "source": "runtime" }
  ],

  "config": [
    { "id": "count-in-beats", "label": "Count-in (beats)", "default": 4 }
  ],

  "facts": [
    { "id": "converter-held", "label": "Another loop holds the converter" }
  ],

  "refusals": [
    { "id": "converter-busy",  "text": "another loop holds the converter" },
    { "id": "nothing-yet",     "text": "nothing recorded yet" },
    { "id": "overdub-in-play", "text": "stopped loops overdub from Playing" }
  ],

  "commands": [
    { "id": "discard-audio",  "label": "Throw away this loop's audio" },
    { "id": "start-count-in", "label": "Start the count-in click" },
    { "id": "stop-count-in",  "label": "Stop the count-in click" },
    { "id": "start-recorder", "label": "Start recording" },
    { "id": "stop-recorder",  "label": "Stop recording" },
    { "id": "start-playback", "label": "Start playing this loop" },
    { "id": "stop-playback",  "label": "Stop playing this loop" },
    { "id": "start-overdub",  "label": "Start overdubbing onto this loop" },
    { "id": "stop-overdub",   "label": "Stop overdubbing" }
  ],

  "rules": [
    { "from": "empty", "on": "record", "cases": [
      { "when": { "fact": "converter-held" }, "refuse": "converter-busy" },
      { "when": { "op": "gt", "left": { "config": "count-in-beats" }, "right": 0 }, "to": "armed" },
      { "to": "recording" }
    ]},
    { "from": "empty", "on": "play",    "cases": [ { "refuse": "nothing-yet" } ] },
    { "from": "empty", "on": "stop",    "cases": [ { "stay": true } ] },
    { "from": "empty", "on": "clear",   "cases": [ { "stay": true } ] },
    { "from": "empty", "on": "elapsed", "cases": [ { "stay": true } ] },

    { "from": "armed", "on": "elapsed", "cases": [ { "to": "recording" } ] },
    { "from": "armed", "on": "record",  "cases": [ { "to": "empty" } ] },
    { "from": "armed", "on": "stop",    "cases": [ { "to": "empty" } ] },
    { "from": "armed", "on": "clear",   "cases": [ { "to": "empty" } ] },
    { "from": "armed", "on": "play",    "cases": [ { "stay": true } ] },

    { "from": "recording", "on": "record",  "cases": [ { "to": "playing" } ] },
    { "from": "recording", "on": "play",    "cases": [ { "to": "playing" } ] },
    { "from": "recording", "on": "stop",    "cases": [ { "to": "stopped" } ] },
    { "from": "recording", "on": "clear",   "cases": [ { "to": "empty" } ] },
    { "from": "recording", "on": "elapsed", "cases": [ { "stay": true } ] },

    { "from": "playing", "on": "record",  "cases": [ { "to": "overdubbing" } ] },
    { "from": "playing", "on": "stop",    "cases": [ { "to": "stopped" } ] },
    { "from": "playing", "on": "clear",   "cases": [ { "to": "empty" } ] },
    { "from": "playing", "on": "play",    "cases": [ { "stay": true } ] },
    { "from": "playing", "on": "elapsed", "cases": [ { "stay": true } ] },

    { "from": "overdubbing", "on": "record",  "cases": [ { "to": "playing" } ] },
    { "from": "overdubbing", "on": "play",    "cases": [ { "to": "playing" } ] },
    { "from": "overdubbing", "on": "stop",    "cases": [ { "to": "stopped" } ] },
    { "from": "overdubbing", "on": "clear",   "cases": [ { "to": "empty" } ] },
    { "from": "overdubbing", "on": "elapsed", "cases": [ { "stay": true } ] },

    { "from": "stopped", "on": "play",    "cases": [ { "to": "playing" } ] },
    { "from": "stopped", "on": "clear",   "cases": [ { "to": "empty" } ] },
    { "from": "stopped", "on": "record",  "cases": [ { "refuse": "overdub-in-play" } ] },
    { "from": "stopped", "on": "stop",    "cases": [ { "stay": true } ] },
    { "from": "stopped", "on": "elapsed", "cases": [ { "stay": true } ] }
  ],

  "deadlines": [
    { "in": "armed", "fires": "elapsed", "after": { "config": "count-in-beats" } }
  ]
}
